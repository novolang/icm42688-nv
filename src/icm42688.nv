// icm42688 — TDK InvenSense's ICM-42688-P six-axis inertial module, on its
// I2C or its SPI bus, as devices-nv's `Accelerometer`, `Gyroscope`, `Imu`,
// `Thermometer` and `Identifiable`.
//
// The facts below are from TDK's data sheet "ICM-42688-P: High Precision
// 6-Axis MEMS MotionTracking Device", document DS-000347, revision 1.9
// (its sections and tables are named by number).  Where the sheet and the
// drivers read for this one disagree, the site says which was taken.
//
// The register map (§§ 13 to 18), as this driver uses it.  Bank 0:
//
//   0x11  DEVICE_CONFIG       SPI_MODE (4), SOFT_RESET_CONFIG (0)
//   0x13  DRIVE_CONFIG        I2C_SLEW_RATE (5:3), SPI_SLEW_RATE (2:0)
//   0x14  INT_CONFIG          INT2 mode (5), drive (4), polarity (3);
//                             INT1 mode (2), drive (1), polarity (0)
//   0x16  FIFO_CONFIG         FIFO_MODE (7:6): 00 bypass, 01 stream
//   0x1D  TEMP_DATA1/0        16 bits, high byte first
//   0x1F  ACCEL_DATA_X1/0 ... 0x24 ACCEL_DATA_Z0: three 16-bit counts
//   0x25  GYRO_DATA_X1/0  ... 0x2A GYRO_DATA_Z0: three 16-bit counts
//   0x2D  INT_STATUS          RESET_DONE_INT (4), DATA_RDY_INT (3),
//                             FIFO_THS_INT (2), FIFO_FULL_INT (1); clears
//                             on read
//   0x2E  FIFO_COUNTH, 0x2F FIFO_COUNTL   high byte first
//   0x30  FIFO_DATA
//   0x4B  SIGNAL_PATH_RESET   FIFO_FLUSH (1)
//   0x4C  INTF_CONFIG0        FIFO_COUNT_REC (6), FIFO_COUNT_ENDIAN (5),
//                             SENSOR_DATA_ENDIAN (4), UI_SIFS_CFG (1:0)
//   0x4E  PWR_MGMT0           TEMP_DIS (5), IDLE (4), GYRO_MODE (3:2),
//                             ACCEL_MODE (1:0)
//   0x4F  GYRO_CONFIG0        GYRO_FS_SEL (7:5), GYRO_ODR (3:0)
//   0x50  ACCEL_CONFIG0       ACCEL_FS_SEL (7:5), ACCEL_ODR (3:0)
//   0x51  GYRO_CONFIG1        GYRO_UI_FILT_ORD (3:2)
//   0x52  GYRO_ACCEL_CONFIG0  ACCEL_UI_FILT_BW (7:4), GYRO_UI_FILT_BW (3:0)
//   0x53  ACCEL_CONFIG1       ACCEL_UI_FILT_ORD (4:3)
//   0x5F  FIFO_CONFIG1        FIFO_RESUME_PARTIAL_RD (6), FIFO_HIRES_EN (4),
//                             FIFO_TEMP_EN (2), FIFO_GYRO_EN (1),
//                             FIFO_ACCEL_EN (0)
//   0x60  FIFO_CONFIG2        FIFO_WM[7:0]
//   0x61  FIFO_CONFIG3        FIFO_WM[11:8]
//   0x64  INT_CONFIG1         INT_TPULSE_DURATION (6), INT_TDEASSERT_DISABLE
//                             (5), INT_ASYNC_RESET (4)
//   0x65  INT_SOURCE0         RESET_DONE_INT1_EN (4), UI_DRDY_INT1_EN (3),
//                             FIFO_THS_INT1_EN (2), FIFO_FULL_INT1_EN (1)
//   0x68  INT_SOURCE3         the same for INT2
//   0x70  SELF_TEST_CONFIG    ACCEL_ST_POWER (6), EN_A[XYZ]_ST (5:3),
//                             EN_G[XYZ]_ST (2:0)
//   0x75  WHO_AM_I            0x47
//   0x76  REG_BANK_SEL        BANK_SEL (2:0), the same in every bank
//
// Bank 1: 0x0B GYRO_CONFIG_STATIC2 (GYRO_AAF_DIS 1), 0x0C ..0x0E the
// gyroscope's anti-alias filter, 0x7C INTF_CONFIG6.  Bank 2: 0x03 to 0x05
// the accelerometer's anti-alias filter.
//
// The step.  The count is 16 bits, high byte first (SENSOR_DATA_ENDIAN is
// set after a reset and kept).  Table 2 gives the accelerometer 2,048,
// 4,096, 8,192 and 16,384 LSB/g at ±16, ±8, ±4 and ±2 g (the full-scale
// code runs from the widest range to the narrowest), and Table 1 gives the
// gyroscope 16.4, 32.8, 65.5, 131, 262, 524.3, 1048.6 and 2097.2 LSB/dps at
// ±2000 dps down to ±15.625 dps.  The driver converts with those numbers,
// the gyroscope's in tenths of a count per degree per second.
//
// The temperature (§ 4.13): degrees Celsius = TEMP_DATA / 132.48 + 25,
// which is milli-degrees = 25000 + TEMP_DATA * 100000 / 13248.
//
// The two buses.  On I2C the part answers at 0x68 (AP_AD0 low) or 0x69
// (high), and a multiple-byte transfer advances the register address
// (§ 9.4).  On SPI a transaction is a control byte, then data, inside one
// chip-select window: bit 7 is R/W (1 reads), bits 6 to 0 the register
// (§ 9.6); mode 0 and mode 3 both work (DEVICE_CONFIG, SPI_MODE clear).
// The part's FIFO_DATA register is read with one burst per packet (the data
// sheet does not say how the address behaves at FIFO_DATA; Zephyr's driver
// reads the FIFO that way).
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/tdk/icm4268x` and the Rust crate `icm426xx` 0.4.0.  Each
// fix kept is named at its site.
//
// The driver holds no state: the full scales and the modes are read from
// the part in the transaction before the sample.
//
// A bus enters through `Icm42688Port`, which a type that holds a bus
// implements: `Icm42688` for an I2C bus and `Icm42688Spi` for an SPI bus.
// The framing of each bus is the generic functions `i2c_read_into`,
// `i2c_write`, `spi_read_into` and `spi_write`, so a test runs them over a
// double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, AccelFifoMode, AccelMode, Accelerometer }
use dev_gyro.{ GyroMilliDps, GyroRange, Gyroscope }
use dev_imu.{ ImuSample, Imu, ImuControl }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }

// The registers of bank 0.
let DEVICE_CONFIG      = 0x11
let DRIVE_CONFIG       = 0x13
let INT_CONFIG         = 0x14
let FIFO_CONFIG        = 0x16
let TEMP_DATA1         = 0x1D
let ACCEL_DATA_X1      = 0x1F
let GYRO_DATA_X1       = 0x25
let INT_STATUS         = 0x2D
let FIFO_COUNTH        = 0x2E
let FIFO_DATA          = 0x30
let SIGNAL_PATH_RESET  = 0x4B
let INTF_CONFIG0       = 0x4C
let PWR_MGMT0          = 0x4E
let GYRO_CONFIG0       = 0x4F
let ACCEL_CONFIG0      = 0x50
let GYRO_CONFIG1       = 0x51
let GYRO_ACCEL_CONFIG0 = 0x52
let ACCEL_CONFIG1      = 0x53
let FIFO_CONFIG1       = 0x5F
let FIFO_CONFIG2       = 0x60
let FIFO_CONFIG3       = 0x61
let INT_CONFIG1        = 0x64
let INT_SOURCE0        = 0x65
let INT_SOURCE3        = 0x68
let SELF_TEST_CONFIG   = 0x70
let WHO_AM_I           = 0x75
let REG_BANK_SEL       = 0x76

// Bank 1 and bank 2.
let GYRO_CONFIG_STATIC2 = 0x0B
let GYRO_AAF_DELT_REG   = 0x0C
let INTF_CONFIG6        = 0x7C
let ACCEL_AAF_DELT_REG  = 0x03

// WHO_AM_I's value.
let ID_ICM42688 = 0x47

// The SPI control byte's R/W bit.
let SPI_READ = 0x80

// DEVICE_CONFIG: the soft reset.
let DC_SOFT_RESET = 0x01
// INT_STATUS: the flags.
let IS_RESET_DONE = 0x10
let IS_DATA_RDY   = 0x08
// SIGNAL_PATH_RESET: the FIFO flush.
let SPR_FIFO_FLUSH = 0x02
// FIFO_CONFIG: bypass and stream-to-FIFO.
let FIFO_BYPASS = 0x00
let FIFO_STREAM = 0x40
let FIFO_STOP   = 0x80
// FIFO_CONFIG1: the sensors, the temperature, and the partial read.
let FC1_ACCEL   = 0x01
let FC1_GYRO    = 0x02
let FC1_TEMP    = 0x04
let FC1_HIRES   = 0x10
let FC1_PARTIAL = 0x40
// INTF_CONFIG0: the FIFO count in records, the byte orders, and I2C off.
let IC0_BASE        = 0x70
let IC0_I2C_DISABLE = 0x03
// INT_SOURCE0: the data-ready and watermark routes.
let IS0_DRDY      = 0x08
let IS0_FIFO_THS  = 0x04
let IS0_FIFO_FULL = 0x02
// The FIFO header.
let HDR_EMPTY = 0x80
let HDR_ACCEL = 0x40
let HDR_GYRO  = 0x20
let HDR_HIRES = 0x10
// The invalid sample (§ 14.34).
let INVALID = -32768

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ   = 400000
let SPI_HZ   = 4000000
let SPI_MODE = 3

// The waits.  The supply ramps in 3 ms and the registers answer 1 ms after
// power-up; a soft reset takes 1 ms (§ 14.1, Zephyr waits 2 ms); a mode
// change takes 200 us before the next write (§ 14.36); the accelerometer
// starts in 10 ms and the gyroscope in 30 ms, and a gyroscope that has been
// started stays on for 45 ms at least.
let WAIT_POWER_US   = 3000
let WAIT_RESET_US   = 2000
let WAIT_MODE_US    = 200
let WAIT_START_US   = 50000
let WAIT_POLL_US    = 500
let RESET_POLLS     = 20
let SELF_TEST_POLLS = 4000

// The most samples the driver moves out of the FIFO into one list.
let LIST_DEPTH = 32

// The self-test (§ 4.9, § 14.57): both sensors in low-noise mode at 1 kHz,
// the accelerometer at ±4 g and the gyroscope at ±250 dps, ten samples
// passed and five averaged.  The data sheet states the response and the
// register and no more; these settings are this driver's.
let ST_ACCEL_CFG  = 0x46
let ST_GYRO_CFG   = 0x66
let ST_ACCEL_BITS = 0x78
let ST_GYRO_BITS  = 0x07
let ST_SETTLE     = 10
let ST_AVERAGE    = 5

// INT_SOURCE0 and INT_SOURCE3's bits for `int_route`.

// The data-ready flag on the pin.
pub const INT_DRDY = 0x08

// The FIFO watermark on the pin.
pub const INT_FIFO_THS = 0x04

// The FIFO-full flag on the pin.
pub const INT_FIFO_FULL = 0x02

// The reset-done flag on the pin.
pub const INT_RESET_DONE = 0x10

// The power mode of a sensor (§ 14.36).  The accelerometer has off,
// low power and low noise; the gyroscope has off, standby and low noise.
pub @value
enum Icm42688Mode
    Icm42688Off
    Icm42688Standby
    Icm42688LowPower
    Icm42688LowNoise

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `irq_level` answers the level of the INT1 pin; `on_spi`
// answers whether the bus is SPI; `wait_us` waits.
pub trait Icm42688Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]
    fn on_spi(self) -> Bool [hw]
    fn wait_us(self, us: Int) [hw]

// ── The two buses ────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the register and a repeated start: whether the part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction: the
// control byte with R/W set, then the data, with no dummy byte in between.
// Whether it ran, which is whether the wiring has a chip select.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int, n: Int,
                                            var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((SPI_READ | (reg & 0x7F)) as u8)
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n, var dst)

// Writes `v` to the register `reg` in one SPI transaction, R/W clear:
// whether it ran.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x7F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the INT1 pin an input, the bus at 400 kHz.
// Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// Makes an SPI bus ready: chip select driven high first, so the pin never
// drives low before it is an output, then an output; the INT1 pin an
// input; the bus at 4 MHz in mode 3.  Answers whether the wiring has a
// chip select.
pub fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    let Some(cs) = w.cs else return false
    gpio.set(cs, 1)
    gpio.mode(cs, 1)
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(SPI_HZ, SPI_MODE)
    true

// The level of the part's INT1 line on the board, 1 or 0, or -1 for a
// wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register of the bank the part is in, or `None` when the part did
// not answer.
pub fn reg_read<P: Icm42688Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  A register with a bit that clears itself is written
// with `write_reg`.
pub fn reg_write<P: Icm42688Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `v`, leaving the others:
// whether the part took it.
//
// Fix kept: several registers hold reserved bits that the data sheet gives
// a reset value (INTF_CONFIG1 is 0x91, GYRO_CONFIG1 0x16), so a
// whole-register write would change what it should not.
pub fn reg_update<P: Icm42688Port>(p: P, reg: Int, mask: Int, v: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (v & mask))

// ── The register banks ───────────────────────────────────────────────

// Selects the register bank `bank`, 0 to 4.  REG_BANK_SEL is the one
// register that every bank has.
pub fn bank_set<P: Icm42688Port>(p: P, bank: Int) -> Bool [hw]
    if bank < 0 or bank > 4
        return false
    reg_write(p, REG_BANK_SEL, bank)

// The register `reg` of bank `bank`, with bank 0 put back also when the
// read failed: `None` when the part did not answer or the bank could not
// be put back.
//
// Fix kept: a part left in another bank answers other registers for every
// later access, so every visit ends in bank 0, as Zephyr's driver ends its
// bank 1 write (INTF_CONFIG5) in bank 0.
pub fn bank_read<P: Icm42688Port>(p: P, bank: Int, reg: Int) -> ?Int [hw]
    if not bank_set(p, bank)
        let _back = bank_set(p, 0)
        return None
    let v = reg_read(p, reg)
    if not bank_set(p, 0)
        return None
    v

// Sets the bits of `mask` in the register `reg` of bank `bank` to the bits
// of `v`, with bank 0 put back also when the work failed: whether the part
// took it and the bank came back.
pub fn bank_update<P: Icm42688Port>(p: P, bank: Int, reg: Int, mask: Int, v: Int) -> Bool [hw]
    if not bank_set(p, bank)
        let _back = bank_set(p, 0)
        return false
    let done = reg_update(p, reg, mask, v)
    let back = bank_set(p, 0)
    done and back

// ── Identity ─────────────────────────────────────────────────────────

// WHO_AM_I as a `DeviceId`, or `None` when no part answers: the byte reads
// 0xFF on an SPI bus no part drives and 0x00 on one held low.
pub fn id_read<P: Icm42688Port>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, WHO_AM_I) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: None })

// ── Ranges and steps ─────────────────────────────────────────────────

// The accelerometer range an ACCEL_CONFIG0 byte selects (§ 14.38): 000
// ±16 g, 001 ±8 g, 010 ±4 g, 011 ±2 g; the codes above are reserved and
// read as ±2 g.
pub fn accel_range_of(cfg0: Int) -> AccelRange
    match (cfg0 >> 5) & 7
        0 => AccelRange16g
        1 => AccelRange8g
        2 => AccelRange4g
        _ => AccelRange2g

// The ACCEL_FS_SEL code for a range.
pub fn accel_fs_of(r: AccelRange) -> Int
    match r
        AccelRange16g => 0
        AccelRange8g  => 1
        AccelRange4g  => 2
        AccelRange2g  => 3

// The gyroscope range a GYRO_CONFIG0 byte selects (§ 14.37): 000 ±2000,
// 001 ±1000, 010 ±500, 011 ±250, 100 ±125, 101 ±62.5, 110 ±31.25 and
// 111 ±15.625 dps.
pub fn gyro_range_of(cfg0: Int) -> GyroRange
    match (cfg0 >> 5) & 7
        0 => GyroRange2000dps
        1 => GyroRange1000dps
        2 => GyroRange500dps
        3 => GyroRange250dps
        4 => GyroRange125dps
        5 => GyroRange62dps
        6 => GyroRange31dps
        _ => GyroRange15dps

// The GYRO_FS_SEL code for a range, -1 for the range of ±4000 dps, which
// the part does not have.
pub fn gyro_fs_of(r: GyroRange) -> Int
    match r
        GyroRange2000dps => 0
        GyroRange1000dps => 1
        GyroRange500dps  => 2
        GyroRange250dps  => 3
        GyroRange125dps  => 4
        GyroRange62dps   => 5
        GyroRange31dps   => 6
        GyroRange15dps   => 7
        GyroRange4000dps => -1

// The accelerometer's counts per g (Table 2).
pub fn lsb_per_g(cfg0: Int) -> Int
    match (cfg0 >> 5) & 7
        0 => 2048
        1 => 4096
        2 => 8192
        _ => 16384

// The gyroscope's counts per degree per second, in tenths (Table 1): 16.4,
// 32.8, 65.5, 131, 262, 524.3, 1048.6 and 2097.2.
pub fn tenth_lsb_per_dps(cfg0: Int) -> Int
    match (cfg0 >> 5) & 7
        0 => 164
        1 => 328
        2 => 655
        3 => 1310
        4 => 2620
        5 => 5243
        6 => 10486
        _ => 20972

// The signed 16-bit count at `i` of `b`, high byte first.
fn s16_at(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i] as Int << 8) | b[i + 1] as Int, 16)

// Whether the three counts at `i` of `b` are samples: the data registers
// read -32768 until the first sample of the sensor, and for a sensor that
// is off (§ 14.34), which is no sample.
fn valid_at(b: DevBytes, i: Int) -> Bool
    s16_at(b, i) != INVALID and s16_at(b, i + 2) != INVALID and s16_at(b, i + 4) != INVALID

// The milli-g of the three axes at `i` of `b`, for `lsb` counts per g.
fn accel_at(b: DevBytes, i: Int, lsb: Int) -> AccelMilliG
    AccelMilliG { x: s16_at(b, i) * 1000 / lsb,
        y: s16_at(b, i + 2) * 1000 / lsb,
        z: s16_at(b, i + 4) * 1000 / lsb }

// The milli-degrees per second of the three axes at `i` of `b`, for `tenth`
// tenths of a count per degree per second.
fn gyro_at(b: DevBytes, i: Int, tenth: Int) -> GyroMilliDps
    GyroMilliDps { x: s16_at(b, i) * 10000 / tenth,
        y: s16_at(b, i + 2) * 10000 / tenth,
        z: s16_at(b, i + 4) * 10000 / tenth }

// ── Rates ────────────────────────────────────────────────────────────

// A rate that only the accelerometer has.
fn slow_odr(accel: Bool, mhz: Int) -> Int
    if accel
        return mhz
    0

// The rate in thousandths of a hertz that an ODR code selects (§§ 14.37 and
// 14.38): 0 for the codes the sensor does not have.  Code 1111 is 500 Hz,
// out of order between 1 kHz and 200 Hz.  The accelerometer's 1.5625 Hz is
// rounded to 1563.
pub fn mhz_of_odr(code: Int, accel: Bool) -> Int
    match code
        1  => 32000000
        2  => 16000000
        3  => 8000000
        4  => 4000000
        5  => 2000000
        6  => 1000000
        7  => 200000
        8  => 100000
        9  => 50000
        10 => 25000
        11 => 12500
        15 => 500000
        12 => slow_odr(accel, 6250)
        13 => slow_odr(accel, 3125)
        14 => slow_odr(accel, 1563)
        _  => 0

// The ODR codes from the slowest rate to the fastest.
fn odr_ascending(i: Int) -> Int
    match i
        0  => 14
        1  => 13
        2  => 12
        3  => 11
        4  => 10
        5  => 9
        6  => 8
        7  => 7
        8  => 15
        9  => 6
        10 => 5
        11 => 4
        12 => 3
        13 => 2
        _  => 1

// Whether a code is one the sensor can run in a mode (§ 14.38): the
// accelerometer in low-noise mode has 12.5 Hz and above, in low-power mode
// 500 Hz and below; the gyroscope has 12.5 Hz and above.
fn odr_allowed(code: Int, accel: Bool, low_power: Bool) -> Bool
    if not accel
        return code <= 11 or code == 15
    if low_power
        return code >= 7
    code <= 11 or code == 15

// The ODR code of the slowest rate at or above `mhz` thousandths of a hertz
// that the sensor can run in its mode, or of the fastest.
pub fn odr_code_for(mhz: Int, accel: Bool, low_power: Bool) -> Int
    var best = 11
    for i in 0..15
        let code = odr_ascending(i)
        if odr_allowed(code, accel, low_power)
            best = code
            if mhz_of_odr(code, accel) >= mhz
                return code
    best

// A rate in thousandths of a hertz as whole hertz: to the nearest, 0 for
// off.
pub fn hz_of_mhz(mhz: Int) -> Int
    if mhz <= 0
        return 0
    (mhz + 500) / 1000

// ── Samples ──────────────────────────────────────────────────────────

// The most recent acceleration in milli-g: the full scale and the six
// output registers, in two transactions.  `None` when the part did not
// answer, and when the sensor has no sample yet or is off (§ 14.34).
pub fn accel_read_of<P: Icm42688Port>(p: P) -> ?AccelMilliG [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(GYRO_CONFIG0, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(ACCEL_DATA_X1, 6, var b)
        return None
    if not valid_at(b, 0)
        return None
    Some(accel_at(b, 0, lsb_per_g(r[1] as Int)))

// The most recent rate of turn in milli-degrees per second, read the same
// way.
pub fn gyro_read_of<P: Icm42688Port>(p: P) -> ?GyroMilliDps [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(GYRO_CONFIG0, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(GYRO_DATA_X1, 6, var b)
        return None
    if not valid_at(b, 0)
        return None
    Some(gyro_at(b, 0, tenth_lsb_per_dps(r[0] as Int)))

// Both from one burst of twelve registers, the accelerometer's first: the
// two are one pair of samples as far as the part's registers go.
pub fn imu_read_of<P: Icm42688Port>(p: P) -> ?ImuSample [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(GYRO_CONFIG0, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(ACCEL_DATA_X1, 12, var b)
        return None
    if not valid_at(b, 0) or not valid_at(b, 6)
        return None
    Some(ImuSample { accel: accel_at(b, 0, lsb_per_g(r[1] as Int)),
        gyro: gyro_at(b, 6, tenth_lsb_per_dps(r[0] as Int)) })

// INT_STATUS, whose flags clear when it is read: `None` when the part did
// not answer.
pub fn int_status<P: Icm42688Port>(p: P) -> ?Int [hw]
    reg_read(p, INT_STATUS)

// Whether a new sample has completed since INT_STATUS was last read:
// DATA_RDY_INT.  The one flag serves the accelerometer and the gyroscope,
// and reading it clears it, so the second of two calls answers false until
// the next sample.
pub fn data_ready_of<P: Icm42688Port>(p: P) -> Bool [hw]
    ((int_status(p) ?? 0) & IS_DATA_RDY) != 0

// The die temperature in milli-degrees Celsius (§ 4.13): TEMP_DATA / 132.48
// + 25.  `None` when the part did not answer or has no sample yet.
pub fn temp_read_of<P: Icm42688Port>(p: P) -> ?TempMilliC [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(TEMP_DATA1, 2, var b)
        return None
    let raw = s16_at(b, 0)
    if raw == INVALID
        return None
    Some(TempMilliC { milli_c: 25000 + raw * 100000 / 13248 })

// ── Full scale, rate and power mode ──────────────────────────────────

// The accelerometer range, ±2 g when the part does not answer.
pub fn accel_range_read<P: Icm42688Port>(p: P) -> AccelRange [hw]
    accel_range_of(reg_read(p, ACCEL_CONFIG0) ?? 0x60)

// Sets the accelerometer range and leaves the rate: whether the part took
// it.
pub fn accel_range_write<P: Icm42688Port>(p: P, r: AccelRange) -> Bool [hw]
    reg_update(p, ACCEL_CONFIG0, 0xE0, accel_fs_of(r) << 5)

// The gyroscope range, ±250 dps when the part does not answer.
pub fn gyro_range_read<P: Icm42688Port>(p: P) -> GyroRange [hw]
    gyro_range_of(reg_read(p, GYRO_CONFIG0) ?? 0x60)

// Sets the gyroscope range and leaves the rate: whether the part took it.
// The range of ±4000 dps is refused, since the part tops out at ±2000.  The
// readings are converted at the sensitivity of the range set.
pub fn gyro_range_write<P: Icm42688Port>(p: P, r: GyroRange) -> Bool [hw]
    let code = gyro_fs_of(r)
    if code < 0
        return false
    reg_update(p, GYRO_CONFIG0, 0xE0, code << 5)

// The accelerometer rate in thousandths of a hertz, 0 when the sensor is
// off, -1 when the part did not answer.  PWR_MGMT0 and the two
// configuration registers come in one burst.
pub fn accel_rate_read<P: Icm42688Port>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PWR_MGMT0, 3, var b)
        return -1
    if (b[0] as Int & 3) < 2
        return 0
    mhz_of_odr(b[2] as Int & 15, true)

// Sets the accelerometer to the slowest rate at or above `mhz` that its
// mode can run, and answers the rate taken: 0 for a request of 0 or less,
// which turns the sensor off, and -1 when the part did not take it.  A
// sensor that is off is turned on in low-noise mode.
//
// Fix kept: the data sheet requires 200 us between a change of mode and the
// next register write (§ 14.36), and Zephyr's driver waits 250 us.
pub fn accel_rate_write<P: Icm42688Port>(p: P, mhz: Int) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PWR_MGMT0, 3, var b)
        return -1
    if mhz <= 0
        if not reg_update(p, PWR_MGMT0, 0x03, 0)
            return -1
        p.wait_us(WAIT_MODE_US)
        return 0
    var mode = b[0] as Int & 3
    if mode < 2
        mode = 3
    let code = odr_code_for(mhz, true, mode == 2)
    if not reg_update(p, ACCEL_CONFIG0, 0x0F, code)
        return -1
    if mode != (b[0] as Int & 3)
        if not reg_update(p, PWR_MGMT0, 0x03, mode)
            return -1
        p.wait_us(WAIT_MODE_US)
    mhz_of_odr(code, true)

// The gyroscope rate in thousandths of a hertz, 0 when the sensor is off or
// in standby, -1 when the part did not answer.
pub fn gyro_rate_read<P: Icm42688Port>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PWR_MGMT0, 3, var b)
        return -1
    if ((b[0] as Int >> 2) & 3) != 3
        return 0
    mhz_of_odr(b[1] as Int & 15, false)

// Sets the gyroscope to the slowest rate at or above `mhz`, as
// `accel_rate_write` does for the accelerometer.
pub fn gyro_rate_write<P: Icm42688Port>(p: P, mhz: Int) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PWR_MGMT0, 3, var b)
        return -1
    if mhz <= 0
        if not reg_update(p, PWR_MGMT0, 0x0C, 0)
            return -1
        p.wait_us(WAIT_MODE_US)
        return 0
    let code = odr_code_for(mhz, false, false)
    if not reg_update(p, GYRO_CONFIG0, 0x0F, code)
        return -1
    if ((b[0] as Int >> 2) & 3) != 3
        if not reg_update(p, PWR_MGMT0, 0x0C, 0x0C)
            return -1
        p.wait_us(WAIT_MODE_US)
    mhz_of_odr(code, false)

// The rate in whole hertz for the traits: the thousandths rounded to the
// nearest.
pub fn accel_rate_hz_read<P: Icm42688Port>(p: P) -> Int [hw]
    hz_of_mhz(accel_rate_read(p))

// The rate taken in whole hertz after `hz` was asked for.
pub fn accel_rate_hz_write<P: Icm42688Port>(p: P, hz: Int) -> Int [hw]
    hz_of_mhz(accel_rate_write(p, hz * 1000))

// The gyroscope's rate in whole hertz.
pub fn gyro_rate_hz_read<P: Icm42688Port>(p: P) -> Int [hw]
    hz_of_mhz(gyro_rate_read(p))

// The gyroscope's rate taken in whole hertz after `hz` was asked for.
pub fn gyro_rate_hz_write<P: Icm42688Port>(p: P, hz: Int) -> Int [hw]
    hz_of_mhz(gyro_rate_write(p, hz * 1000))

// The rate both sensors run at, in whole hertz, for `ImuControl`: the
// accelerometer's when it is on, else the gyroscope's, 0 when both are off
// or the part did not answer.
pub fn imu_rate_read<P: Icm42688Port>(p: P) -> Int [hw]
    let a = accel_rate_read(p)
    if a > 0
        return hz_of_mhz(a)
    hz_of_mhz(gyro_rate_read(p))

// Sets both sensors to the slowest rate at or above `hz` that each can run
// and answers the accelerometer's rate taken, in whole hertz, which is never
// above the gyroscope's: 0 when the part did not take it.  The sensors share
// the rate in low-noise mode; an accelerometer in low-power mode runs the
// rates of 500 Hz and below, so its rate can be the lower.  A request below
// 1 Hz is taken as 1 Hz, since the sensors are turned off with
// `imu_standby_write`.
pub fn imu_rate_write<P: Icm42688Port>(p: P, hz: Int) -> Int [hw]
    var want = hz
    if want < 1
        want = 1
    let a = accel_rate_write(p, want * 1000)
    let g = gyro_rate_write(p, want * 1000)
    if a < 0 or g < 0
        return 0
    hz_of_mhz(a)

// The ACCEL_MODE code for a mode, -1 for a mode the accelerometer does not
// have.
fn accel_mode_code(m: Icm42688Mode) -> Int
    match m
        Icm42688Off      => 0
        Icm42688LowPower => 2
        Icm42688LowNoise => 3
        Icm42688Standby  => -1

// The GYRO_MODE code for a mode, -1 for a mode the gyroscope does not have.
fn gyro_mode_code(m: Icm42688Mode) -> Int
    match m
        Icm42688Off      => 0
        Icm42688Standby  => 1
        Icm42688LowNoise => 3
        Icm42688LowPower => -1

// The accelerometer's power mode (§ 14.36), off when the part does not
// answer.  The code 01 turns the accelerometer off as 00 does.
pub fn accel_mode_read<P: Icm42688Port>(p: P) -> Icm42688Mode [hw]
    match (reg_read(p, PWR_MGMT0) ?? 0) & 3
        2 => Icm42688LowPower
        3 => Icm42688LowNoise
        _ => Icm42688Off

// Sets the accelerometer's power mode: whether the part took it.  The
// accelerometer has no standby, so `Icm42688Standby` is refused.
//
// Fix kept: the use notes of § 12.1 ask software to raise a rate below
// 12.5 Hz to 12.5 Hz when the mode changes from low power to low noise, and
// to lower a rate above 500 Hz to 500 Hz when it changes the other way,
// since each mode does not run those rates.
pub fn accel_mode_write<P: Icm42688Port>(p: P, m: Icm42688Mode) -> Bool [hw]
    let code = accel_mode_code(m)
    if code < 0
        return false
    if code != 0
        let Some(cfg) = reg_read(p, ACCEL_CONFIG0) else return false
        let odr = cfg & 15
        if not odr_allowed(odr, true, code == 2)
            let fixed = odr_code_for(mhz_of_odr(odr, true), true, code == 2)
            if not reg_update(p, ACCEL_CONFIG0, 0x0F, fixed)
                return false
    if not reg_update(p, PWR_MGMT0, 0x03, code)
        return false
    p.wait_us(WAIT_MODE_US)
    true

// The accelerometer's mode as `Accelerometer.accel_mode` states it: low
// power is `AccelLowPower` and low noise is `AccelNormal`, the part's only
// two running modes.  `None` when the accelerometer is off or the part did
// not answer.
pub fn accel_mode_of<P: Icm42688Port>(p: P) -> ?AccelMode [hw]
    match accel_mode_read(p)
        Icm42688LowPower => Some(AccelLowPower)
        Icm42688LowNoise => Some(AccelNormal)
        _                => None

// Puts the accelerometer in the mode nearest `m`: low power for
// `AccelLowPower`, low noise for the other two, since low noise is the
// part's lowest-noise mode.  Whether the part took it.
pub fn accel_mode_set<P: Icm42688Port>(p: P, m: AccelMode) -> Bool [hw]
    match m
        AccelLowPower => accel_mode_write(p, Icm42688LowPower)
        _             => accel_mode_write(p, Icm42688LowNoise)

// The gyroscope's power mode, off when the part does not answer.
pub fn gyro_mode_read<P: Icm42688Port>(p: P) -> Icm42688Mode [hw]
    match ((reg_read(p, PWR_MGMT0) ?? 0) >> 2) & 3
        1 => Icm42688Standby
        3 => Icm42688LowNoise
        _ => Icm42688Off

// Sets the gyroscope's power mode: whether the part took it.  The gyroscope
// has no low-power mode, so `Icm42688LowPower` is refused.  Once on, the
// gyroscope has to stay on for 45 ms before it is turned off (§ 14.36).
pub fn gyro_mode_write<P: Icm42688Port>(p: P, m: Icm42688Mode) -> Bool [hw]
    let code = gyro_mode_code(m)
    if code < 0
        return false
    if not reg_update(p, PWR_MGMT0, 0x0C, code << 2)
        return false
    p.wait_us(WAIT_MODE_US)
    true

// Puts the accelerometer and the gyroscope in standby, or takes them out of
// it, for `ImuControl`: whether the part took both.  The gyroscope has a
// standby mode; the accelerometer has none, and off is its nearest, so
// `accel` turns it off.  Taking a sensor out of standby turns it on in
// low-noise mode, and leaves a sensor that is already running as it is, so
// a sensor in low-power mode keeps that mode.
pub fn imu_standby_write<P: Icm42688Port>(p: P, accel: Bool, gyro: Bool) -> Bool [hw]
    let Some(pm) = reg_read(p, PWR_MGMT0) else return false
    let accel_on = (pm & 3) >= 2
    let gyro_on = ((pm >> 2) & 3) == 3
    var ok = true
    if accel and accel_on
        ok = accel_mode_write(p, Icm42688Off)
    if not accel and not accel_on
        ok = accel_mode_write(p, Icm42688LowNoise)
    if gyro and gyro_on
        ok = ok and gyro_mode_write(p, Icm42688Standby)
    if not gyro and not gyro_on
        ok = ok and gyro_mode_write(p, Icm42688LowNoise)
    ok

// Turns the temperature sensor on or off (TEMP_DIS): whether the part took
// it.
pub fn temp_enable<P: Icm42688Port>(p: P, on: Bool) -> Bool [hw]
    var v = 0
    if not on
        v = 0x20
    reg_update(p, PWR_MGMT0, 0x20, v)

// ── Filters ──────────────────────────────────────────────────────────

// The anti-alias filter's row for DELT 1 to 63 (§ 5.3): the 3 dB bandwidth
// in hertz in bits 31 to 20, DELTSQR in bits 15 to 4 and BITSHIFT in bits
// 3 to 0.  0 for a DELT outside the table.
pub fn aaf_row(delt: Int) -> Int
    match delt
        1  => 44040223
        2  => 88080461
        3  => 132120732
        4  => 178258187
        5  => 223347098
        6  => 270533194
        7  => 317719321
        8  => 364905481
        9  => 413140249
        10 => 462423624
        11 => 511707048
        12 => 562039048
        13 => 613419688
        14 => 664800327
        15 => 717229575
        16 => 769658887
        17 => 823136775
        18 => 877663303
        19 => 933238406
        20 => 988813574
        21 => 1045437318
        22 => 1102061190
        23 => 1160782086
        24 => 1219503110
        25 => 1279272710
        26 => 1339042438
        27 => 1400909317
        28 => 1462776069
        29 => 1524643077
        30 => 1588606981
        31 => 1653619717
        32 => 1718632453
        33 => 1784693765
        34 => 1851803653
        35 => 1918913797
        36 => 1988120837
        37 => 2057328132
        38 => 2127583748
        39 => 2198888452
        40 => 2271241220
        41 => 2343594500
        42 => 2418044420
        43 => 2492494852
        44 => 2567993860
        45 => 2644540932
        46 => 2722137092
        47 => 2800781828
        48 => 2879426564
        49 => 2960168452
        50 => 3040910340
        51 => 3122700804
        52 => 3205540356
        53 => 3289427971
        54 => 3373316099
        55 => 3459300355
        56 => 3545285635
        57 => 3632319491
        58 => 3720401923
        59 => 3809531907
        60 => 3898662915
        61 => 3989891075
        62 => 4081119235
        63 => 4172347395
        _  => 0

// The 3 dB bandwidth of the anti-alias filter for a DELT, in hertz.
pub fn aaf_bandwidth_hz(delt: Int) -> Int
    aaf_row(delt) >> 20

// The accelerometer's anti-alias filter at DELT 1 to 63 (42 Hz to 3979 Hz),
// from the table of § 5.3: ACCEL_AAF_DELT, ACCEL_AAF_DELTSQR and
// ACCEL_AAF_BITSHIFT in bank 2, with the filter enabled.  Bank 0 is put
// back.  Whether the part took it; false for a DELT outside the table.  The
// filter is for low-noise mode only (§ 12.4).
pub fn accel_aaf_write<P: Icm42688Port>(p: P, delt: Int) -> Bool [hw]
    let row = aaf_row(delt)
    if row == 0
        return false
    let sqr = (row >> 4) & 0xFFF
    let shift = row & 15
    if not bank_set(p, 2)
        let _back = bank_set(p, 0)
        return false
    let ok = reg_write(p, ACCEL_AAF_DELT_REG, delt << 1) and reg_write(p, ACCEL_AAF_DELT_REG + 1, sqr & 0xFF) and reg_write(p, ACCEL_AAF_DELT_REG + 2, (shift << 4) | (sqr >> 8))
    let back = bank_set(p, 0)
    ok and back

// Turns the accelerometer's anti-alias filter off (ACCEL_AAF_DIS): whether
// the part took it.
pub fn accel_aaf_disable<P: Icm42688Port>(p: P) -> Bool [hw]
    bank_update(p, 2, ACCEL_AAF_DELT_REG, 0x01, 0x01)

// The gyroscope's anti-alias filter at DELT 1 to 63, in bank 1, with the
// filter enabled; as `accel_aaf_write` does.
pub fn gyro_aaf_write<P: Icm42688Port>(p: P, delt: Int) -> Bool [hw]
    let row = aaf_row(delt)
    if row == 0
        return false
    let sqr = (row >> 4) & 0xFFF
    let shift = row & 15
    if not bank_set(p, 1)
        let _back = bank_set(p, 0)
        return false
    let ok = reg_update(p, GYRO_CONFIG_STATIC2, 0x02, 0) and reg_write(p, GYRO_AAF_DELT_REG, delt) and reg_write(p, GYRO_AAF_DELT_REG + 1, sqr & 0xFF) and reg_write(p, GYRO_AAF_DELT_REG + 2, (shift << 4) | (sqr >> 8))
    let back = bank_set(p, 0)
    ok and back

// Turns the gyroscope's anti-alias filter off (GYRO_AAF_DIS): whether the
// part took it.
pub fn gyro_aaf_disable<P: Icm42688Port>(p: P) -> Bool [hw]
    bank_update(p, 1, GYRO_CONFIG_STATIC2, 0x02, 0x02)

// Whether a UI filter bandwidth code is one the data sheet defines
// (§ 14.40): 0 to 7, and 14 and 15, the two low-latency options.
fn ui_bw_valid(code: Int) -> Bool
    code >= 0 and (code <= 7 or code == 14 or code == 15)

// Sets the order of the UI filters (§ 5.5), 0 for first order, 1 for second
// and 2 for third, for the accelerometer and the gyroscope: whether the
// part took both.  An order above 2 is reserved and refused.
pub fn ui_filter_order_write<P: Icm42688Port>(p: P, accel_order: Int, gyro_order: Int) -> Bool [hw]
    if accel_order < 0 or accel_order > 2 or gyro_order < 0 or gyro_order > 2
        return false
    reg_update(p, ACCEL_CONFIG1, 0x18, accel_order << 3) and reg_update(p, GYRO_CONFIG1, 0x0C, gyro_order << 2)

// Sets the bandwidth codes of the UI filters (§ 14.40) for the
// accelerometer and the gyroscope: whether the part took both.  A code the
// data sheet does not define is refused.
pub fn ui_filter_bw_write<P: Icm42688Port>(p: P, accel_bw: Int, gyro_bw: Int) -> Bool [hw]
    if not ui_bw_valid(accel_bw) or not ui_bw_valid(gyro_bw)
        return false
    reg_write(p, GYRO_ACCEL_CONFIG0, (accel_bw << 4) | gyro_bw)

// ── Interrupt pins ───────────────────────────────────────────────────

// Sets INT_SOURCE0 to `mask`, built from the `INT_` constants: the routes
// to INT1.  Whether the part took it.  `start` sets the data-ready route.
pub fn int1_route<P: Icm42688Port>(p: P, mask: Int) -> Bool [hw]
    reg_write(p, INT_SOURCE0, mask)

// Sets INT_SOURCE3 to `mask`: the routes to INT2.
pub fn int2_route<P: Icm42688Port>(p: P, mask: Int) -> Bool [hw]
    reg_write(p, INT_SOURCE3, mask)

// Sets the pins' polarity and output type, for both pins, in pulsed mode:
// `active_low` makes them active low, `open_drain` makes them open-drain in
// place of push-pull.  Whether the part took it.
pub fn int_pins_config<P: Icm42688Port>(p: P, active_low: Bool, open_drain: Bool) -> Bool [hw]
    var v = 0
    if not active_low
        v = v | 0x09
    if not open_drain
        v = v | 0x12
    reg_write(p, INT_CONFIG, v)

// Sets the pulse timing of the interrupt pins for a data rate of 4 kHz and
// above (`fast`), or for the slower rates: INT_TPULSE_DURATION and
// INT_TDEASSERT_DISABLE are required for 4 kHz and above (§ 14.50).  The
// INT_ASYNC_RESET bit stays 0.  Whether the part took it.
pub fn int_timing<P: Icm42688Port>(p: P, fast: Bool) -> Bool [hw]
    var v = 0
    if fast
        v = 0x60
    reg_write(p, INT_CONFIG1, v)

// ── The FIFO ─────────────────────────────────────────────────────────
//
// The FIFO is 2 KB (§ 6.3).  It is off after `start`.  `fifo_start` turns
// it on in stream mode, which overwrites the oldest packet when it is full,
// with the accelerometer batched and the gyroscope too when asked.  A
// packet is 8 bytes for one sensor (a header, six data bytes and the
// temperature) and 16 for both (a header, twelve data bytes, the
// temperature and a 16-bit timestamp), § 6.1.  The count the part gives is
// in packets, since `start` sets FIFO_COUNT_REC.  The 20-bit packet
// (FIFO_HIRES_EN) is not read.

// The packet length for a FIFO_CONFIG1 byte: 16 when both sensors are
// batched, 8 for one, 0 for none and for the 20-bit packet.
fn packet_len(cfg1: Int) -> Int
    if (cfg1 & FC1_HIRES) != 0
        return 0
    let a = (cfg1 & FC1_ACCEL) != 0
    let g = (cfg1 & FC1_GYRO) != 0
    if a and g
        return 16
    if a or g
        return 8
    0

// The number of packets in the FIFO, 0 when it is empty or the part did not
// answer: FIFO_COUNTH and FIFO_COUNTL, high byte first.  Reading the high
// byte latches both (§ 14.22), so they are read in one burst.
pub fn fifo_count<P: Icm42688Port>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(FIFO_COUNTH, 2, var b)
        return 0
    (b[0] as Int << 8) | b[1] as Int

// Turns the FIFO on in stream mode with the watermark at `threshold`
// packets and puts the watermark on INT1 in place of the data-ready flag:
// whether the part took every setting.  The accelerometer is batched, and
// the gyroscope when `with_gyro`.  The threshold is limited to 1 to the
// packets the FIFO holds less one, 127 for 16-byte packets and 255 for
// 8-byte ones.
//
// Fixes kept: Zephyr's driver switches the interrupt sources off while it
// configures, puts the FIFO in bypass and flushes it first; the watermark
// must not be 0 (§ 14.47); and FIFO_RESUME_PARTIAL_RD is set, since without
// it a read that does not take the whole FIFO has to read it all again
// (§ 14.45), and this driver reads a packet at a time.
pub fn fifo_start<P: Icm42688Port>(p: P, threshold: Int, with_gyro: Bool) -> Bool [hw]
    fifo_run(p, threshold, with_gyro, FIFO_STREAM)

// `fifo_start` with the FIFO_MODE bits given: `FIFO_STREAM` overwrites the
// oldest packet when the FIFO is full, `FIFO_STOP` stops collecting.
fn fifo_run<P: Icm42688Port>(p: P, threshold: Int, with_gyro: Bool, mode: Int) -> Bool [hw]
    var cfg1 = FC1_ACCEL | FC1_TEMP | FC1_PARTIAL
    var cap = 255
    if with_gyro
        cfg1 = cfg1 | FC1_GYRO
        cap = 127
    var th = threshold
    if th < 1
        th = 1
    if th > cap
        th = cap
    if not reg_update(p, INT_SOURCE0, IS0_DRDY | IS0_FIFO_THS | IS0_FIFO_FULL, 0)
        return false
    if not reg_write(p, FIFO_CONFIG, FIFO_BYPASS)
        return false
    if not p.write_reg(SIGNAL_PATH_RESET, SPR_FIFO_FLUSH)
        return false
    if not reg_write(p, FIFO_CONFIG1, cfg1)
        return false
    if not reg_write(p, FIFO_CONFIG2, th & 0xFF)
        return false
    if not reg_write(p, FIFO_CONFIG3, (th >> 8) & 0x0F)
        return false
    if not reg_update(p, INT_SOURCE0, IS0_DRDY | IS0_FIFO_THS, IS0_FIFO_THS)
        return false
    reg_write(p, FIFO_CONFIG, mode)

// Turns the FIFO off, which empties it, stops the batching and puts the
// data-ready flag back on INT1: whether the part took every setting.
pub fn fifo_stop<P: Icm42688Port>(p: P) -> Bool [hw]
    if not reg_write(p, FIFO_CONFIG, FIFO_BYPASS)
        return false
    if not p.write_reg(SIGNAL_PATH_RESET, SPR_FIFO_FLUSH)
        return false
    if not reg_write(p, FIFO_CONFIG1, 0)
        return false
    reg_update(p, INT_SOURCE0, IS0_DRDY | IS0_FIFO_THS, IS0_DRDY)

// What the FIFO does and the watermark in packets, 1 to 32, for
// `Accelerometer.accel_fifo_config`: whether the part took every setting.
// `AccelFifoOff` bypasses the FIFO and empties it (`fifo_stop`), the
// watermark ignored.  `AccelFifoStream` is stream mode and `AccelFifoStop`
// the part's stop-on-full mode, both with the accelerometer batched and the
// gyroscope too when it is running, since a packet that carries both is the
// part's own form for an IMU.  A watermark outside 1 to 32 is refused.
pub fn fifo_configure<P: Icm42688Port>(p: P, mode: AccelFifoMode, watermark: Int) -> Bool [hw]
    if mode == AccelFifoOff
        return fifo_stop(p)
    if watermark < 1 or watermark > LIST_DEPTH
        return false
    let Some(pm) = reg_read(p, PWR_MGMT0) else return false
    var reg = FIFO_STREAM
    if mode == AccelFifoStop
        reg = FIFO_STOP
    fifo_run(p, watermark, ((pm >> 2) & 3) == 3, reg)

// Whether the FIFO holds at least the watermark that FIFO_CONFIG2 and
// FIFO_CONFIG3 hold: the count against the watermark, in packets.  The
// part's own FIFO_THS_INT flag is in INT_STATUS, which clears on read and
// would take the data-ready flag with it, so it is not read.  False for a
// FIFO with no watermark set and when the part did not answer.
pub fn fifo_watermark_reached<P: Icm42688Port>(p: P) -> Bool [hw]
    var w: DevBytes = Vec.new()
    if not p.read_regs(FIFO_CONFIG2, 2, var w)
        return false
    let wm = w[0] as Int | ((w[1] as Int & 0x0F) << 8)
    if wm == 0
        return false
    fifo_count(p) >= wm

// Takes one packet of `len` bytes out of the FIFO into `b`: whether the
// part answered.
fn fifo_packet<P: Icm42688Port>(p: P, len: Int, var b: DevBytes) -> Bool [hw]
    p.read_regs(FIFO_DATA, len, var b)

// Moves the accelerometer's samples of the FIFO, oldest first, into `dst`,
// which is emptied first, and answers how many packets it took out.  A
// sample marked invalid (-32768) is taken out and dropped; so is the
// gyroscope's half of a packet.  The count is read once, the configuration
// once and the full scale once.
pub fn fifo_read<P: Icm42688Port>(p: P, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
    dst.clear()
    let n = fifo_count(p)
    if n == 0
        return 0
    var r: DevBytes = Vec.new()
    if not p.read_regs(ACCEL_CONFIG0, 1, var r)
        return 0
    var c: DevBytes = Vec.new()
    if not p.read_regs(FIFO_CONFIG1, 1, var c)
        return 0
    let len = packet_len(c[0] as Int)
    if len == 0
        return 0
    let lsb = lsb_per_g(r[0] as Int)
    var moved = 0
    for _i in 0..n
        if dst.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        if not fifo_packet(p, len, var b)
            break
        if (b[0] as Int & HDR_EMPTY) != 0
            break
        moved = moved + 1
        if (b[0] as Int & HDR_ACCEL) != 0 and valid_at(b, 1)
            let _ = dst.push(accel_at(b, 1, lsb))
    moved

// Moves the FIFO's samples into `accel` and `gyro`, each emptied first,
// oldest first, and answers how many packets it took out.  It stops when
// either list is full, so no packet is taken out without room.
pub fn fifo_read_imu<P: Icm42688Port>(p: P, var accel: Vec[AccelMilliG; 32],
                                      var gyro: Vec[GyroMilliDps; 32]) -> Int [hw]
    accel.clear()
    gyro.clear()
    let n = fifo_count(p)
    if n == 0
        return 0
    var r: DevBytes = Vec.new()
    if not p.read_regs(GYRO_CONFIG0, 2, var r)
        return 0
    var c: DevBytes = Vec.new()
    if not p.read_regs(FIFO_CONFIG1, 1, var c)
        return 0
    let len = packet_len(c[0] as Int)
    if len == 0
        return 0
    let lsb = lsb_per_g(r[1] as Int)
    let tenth = tenth_lsb_per_dps(r[0] as Int)
    var moved = 0
    for _i in 0..n
        if accel.len() >= LIST_DEPTH or gyro.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        if not fifo_packet(p, len, var b)
            break
        let h = b[0] as Int
        if (h & HDR_EMPTY) != 0
            break
        moved = moved + 1
        var at = 1
        if (h & HDR_ACCEL) != 0
            if valid_at(b, at)
                let _ = accel.push(accel_at(b, at, lsb))
            at = at + 6
        if (h & HDR_GYRO) != 0 and valid_at(b, at)
            let _ = gyro.push(gyro_at(b, at, tenth))
    moved

// ── Self-test ────────────────────────────────────────────────────────

// Waits for the data-ready flag by polling INT_STATUS, at most
// `SELF_TEST_POLLS` times: whether it came.
fn wait_ready<P: Icm42688Port>(p: P) -> Bool [hw]
    for _i in 0..SELF_TEST_POLLS
        if data_ready_of(p)
            return true
    false

// Lets `ST_SETTLE` samples pass and averages the next `ST_AVERAGE`, in
// milli-g: `None` when a sample did not come.
fn accel_mean<P: Icm42688Port>(p: P) -> ?AccelMilliG [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..ST_SETTLE + ST_AVERAGE
        if not wait_ready(p)
            return None
        let Some(s) = accel_read_of(p) else return None
        if i >= ST_SETTLE
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(AccelMilliG { x: sx / ST_AVERAGE, y: sy / ST_AVERAGE, z: sz / ST_AVERAGE })

// The same for the gyroscope, in milli-degrees per second.
fn gyro_mean<P: Icm42688Port>(p: P) -> ?GyroMilliDps [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..ST_SETTLE + ST_AVERAGE
        if not wait_ready(p)
            return None
        let Some(s) = gyro_read_of(p) else return None
        if i >= ST_SETTLE
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(GyroMilliDps { x: sx / ST_AVERAGE, y: sy / ST_AVERAGE, z: sz / ST_AVERAGE })

// Puts both sensors in low-noise mode at 1 kHz with the self-test's ranges
// and waits for them to start: whether the part took it.
fn self_test_prepare<P: Icm42688Port>(p: P) -> Bool [hw]
    if not reg_update(p, PWR_MGMT0, 0x0F, 0x0F)
        return false
    p.wait_us(WAIT_MODE_US)
    if not reg_write(p, ACCEL_CONFIG0, ST_ACCEL_CFG)
        return false
    if not reg_write(p, GYRO_CONFIG0, ST_GYRO_CFG)
        return false
    p.wait_us(WAIT_START_US)
    true

// The change the accelerometer's self-test makes to its outputs (§ 4.9):
// the response is the output with the self-test enabled minus the output
// with it disabled.  Both sensors are put in low-noise mode at 1 kHz, the
// accelerometer at ±4 g, five samples are averaged after ten have passed
// with the self-test off and again with ACCEL_ST_POWER and the three axes'
// enables set, and the answer is the second mean minus the first, in
// milli-g.  The settings the part had are put back, and SELF_TEST_CONFIG is
// cleared, as § 14.57 asks.  The board must be still.  `None` when the part
// did not answer or a sample did not come.  The data sheet gives no limits
// for the response.
pub fn accel_self_test<P: Icm42688Port>(p: P) -> ?AccelMilliG [hw]
    var save: DevBytes = Vec.new()
    if not p.read_regs(PWR_MGMT0, 3, var save)
        return None
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if self_test_prepare(p) and reg_write(p, SELF_TEST_CONFIG, 0)
        if let Some(off) = accel_mean(p)
            if reg_write(p, SELF_TEST_CONFIG, ST_ACCEL_BITS)
                if let Some(on) = accel_mean(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back_st = reg_write(p, SELF_TEST_CONFIG, 0)
    let _back_a = reg_write(p, ACCEL_CONFIG0, save[2] as Int)
    let _back_g = reg_write(p, GYRO_CONFIG0, save[1] as Int)
    let _back_p = reg_write(p, PWR_MGMT0, save[0] as Int)
    p.wait_us(WAIT_MODE_US)
    if not ok
        return None
    Some(AccelMilliG { x: dx, y: dy, z: dz })

// The change the gyroscope's self-test makes, with the gyroscope at ±250
// dps, in milli-degrees per second.
pub fn gyro_self_test<P: Icm42688Port>(p: P) -> ?GyroMilliDps [hw]
    var save: DevBytes = Vec.new()
    if not p.read_regs(PWR_MGMT0, 3, var save)
        return None
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if self_test_prepare(p) and reg_write(p, SELF_TEST_CONFIG, 0)
        if let Some(off) = gyro_mean(p)
            if reg_write(p, SELF_TEST_CONFIG, ST_GYRO_BITS)
                if let Some(on) = gyro_mean(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back_st = reg_write(p, SELF_TEST_CONFIG, 0)
    let _back_a = reg_write(p, ACCEL_CONFIG0, save[2] as Int)
    let _back_g = reg_write(p, GYRO_CONFIG0, save[1] as Int)
    let _back_p = reg_write(p, PWR_MGMT0, save[0] as Int)
    p.wait_us(WAIT_MODE_US)
    if not ok
        return None
    Some(GyroMilliDps { x: dx, y: dy, z: dz })

// ── Bring-up ─────────────────────────────────────────────────────────

// Waits for the soft reset to finish: INT_STATUS reads RESET_DONE_INT
// (§ 14.21), which clears on that read.  A read that fails counts as not
// finished.  Whether it finished within `RESET_POLLS` polls.
fn wait_reset<P: Icm42688Port>(p: P) -> Bool [hw]
    for _i in 0..RESET_POLLS
        p.wait_us(WAIT_POLL_US)
        if ((reg_read(p, INT_STATUS) ?? 0) & IS_RESET_DONE) != 0
            return true
    false

// Brings the part up: the bus made ready; the supply ramp waited; the
// register bank set to bank 0; a soft reset, its end waited for and read
// from INT_STATUS; WHO_AM_I checked; the FIFO count in packets with the
// data in big-endian order and, on SPI, the I2C block off; on I2C the slew
// rate of § 12.3 and the I3C block of its table; INT_ASYNC_RESET cleared;
// the pins push-pull, active high and pulsed; the data-ready flag on INT1;
// and both sensors in low-noise mode at 100 Hz, ±2 g and ±250 dps.
// Answers whether the part answered as an ICM-42688-P and took every
// setting.  The caller has powered the part; the first samples come one
// period after the sensors have started, and the gyroscope's start-up of
// 30 ms is waited here.
//
// Fixes kept: Zephyr's driver waits 3 ms for the supply, resets the part
// with DEVICE_CONFIG and checks RESET_DONE_INT before it reads WHO_AM_I, and
// waits 250 us after PWR_MGMT0 and 50 ms after the rates, as this does; the
// data sheet's use notes ask INT_ASYNC_RESET to be cleared for the pins to
// work (§ 12.6) and give the I2C and SPI settings (§ 12.3).
pub fn start<P: Icm42688Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    p.wait_us(WAIT_POWER_US)
    if not reg_write(p, REG_BANK_SEL, 0)
        return false
    if not p.write_reg(DEVICE_CONFIG, DC_SOFT_RESET)
        return false
    p.wait_us(WAIT_RESET_US)
    if not wait_reset(p)
        return false
    if reg_read(p, WHO_AM_I) != Some(ID_ICM42688)
        return false
    var ic0 = IC0_BASE
    if p.on_spi()
        ic0 = ic0 | IC0_I2C_DISABLE
    if not reg_write(p, INTF_CONFIG0, ic0)
        return false
    if not p.on_spi()
        if not reg_write(p, DRIVE_CONFIG, 0x09)
            return false
        if not bank_update(p, 1, INTF_CONFIG6, 0x13, 0x10)
            return false
    if not reg_write(p, INT_CONFIG1, 0)
        return false
    if not reg_write(p, INT_CONFIG, 0x1B)
        return false
    if not reg_write(p, INT_SOURCE0, IS0_DRDY)
        return false
    if not reg_write(p, GYRO_CONFIG0, 0x68)
        return false
    if not reg_write(p, ACCEL_CONFIG0, 0x68)
        return false
    if not reg_update(p, PWR_MGMT0, 0x0F, 0x0F)
        return false
    p.wait_us(WAIT_MODE_US)
    p.wait_us(WAIT_START_US)
    true

// ── The part on an I2C bus ───────────────────────────────────────────

// An ICM-42688-P on a board's I2C bus at the address `w.addr`, 0x68 or
// 0x69, with the board's GPIO for the INT1 line.
pub @value
struct Icm42688
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Icm42688Port for Icm42688
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

    fn on_spi(self) -> Bool [hw]
        false

    fn wait_us(self, us: Int) [hw]
        self.bus.delay_us(us)

impl Icm42688
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Icm42688
        Icm42688 { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The register of another bank (`bank_read`, `bank_update`).
    fn bank_reg(self, bank: Int, r: Int) -> ?Int [hw]
        bank_read(self, bank, r)

    fn set_bank_reg(self, bank: Int, r: Int, mask: Int, v: Int) -> Bool [hw]
        bank_update(self, bank, r, mask, v)

    // The gyroscope's setter for the rate, and its rates in thousandths of
    // a hertz; the accelerometer's are `Accelerometer.accel_rate_mhz` and
    // `accel_set_rate_mhz`.
    fn gyro_set_rate_hz(self, hz: Int) -> Int [hw]
        gyro_rate_hz_write(self, hz)

    fn gyro_rate_mhz(self) -> Int [hw]
        gyro_rate_read(self)

    fn set_gyro_rate_mhz(self, mhz: Int) -> Int [hw]
        gyro_rate_write(self, mhz)

    // The gyroscope's power mode and the temperature sensor; the
    // accelerometer's modes are `Accelerometer.accel_mode` and
    // `accel_set_mode`, and `ImuControl.imu_standby` turns either sensor
    // off.
    fn gyro_mode(self) -> Icm42688Mode [hw]
        gyro_mode_read(self)

    fn set_gyro_mode(self, m: Icm42688Mode) -> Bool [hw]
        gyro_mode_write(self, m)

    fn set_temp_enabled(self, on: Bool) -> Bool [hw]
        temp_enable(self, on)

    // The filters.
    fn accel_aaf(self, delt: Int) -> Bool [hw]
        accel_aaf_write(self, delt)

    fn accel_aaf_off(self) -> Bool [hw]
        accel_aaf_disable(self)

    fn gyro_aaf(self, delt: Int) -> Bool [hw]
        gyro_aaf_write(self, delt)

    fn gyro_aaf_off(self) -> Bool [hw]
        gyro_aaf_disable(self)

    fn set_ui_filter_order(self, accel_order: Int, gyro_order: Int) -> Bool [hw]
        ui_filter_order_write(self, accel_order, gyro_order)

    fn set_ui_filter_bw(self, accel_bw: Int, gyro_bw: Int) -> Bool [hw]
        ui_filter_bw_write(self, accel_bw, gyro_bw)

    // The interrupt pins, and INT_STATUS.
    fn route_int1(self, mask: Int) -> Bool [hw]
        int1_route(self, mask)

    fn route_int2(self, mask: Int) -> Bool [hw]
        int2_route(self, mask)

    fn configure_pins(self, active_low: Bool, open_drain: Bool) -> Bool [hw]
        int_pins_config(self, active_low, open_drain)

    fn set_int_timing(self, fast: Bool) -> Bool [hw]
        int_timing(self, fast)

    fn status(self) -> ?Int [hw]
        int_status(self)

    // The FIFO: off, and both sensors' samples.  It is turned on with
    // `Accelerometer.accel_fifo_config`.
    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    fn fifo_take_imu(self, var accel: Vec[AccelMilliG; 32],
                     var gyro: Vec[GyroMilliDps; 32]) -> Int [hw]
        fifo_read_imu(self, var accel, var gyro)

    // The self-tests (`accel_self_test`, `gyro_self_test`).
    fn accel_test(self) -> ?AccelMilliG [hw]
        accel_self_test(self)

    fn gyro_test(self) -> ?GyroMilliDps [hw]
        gyro_self_test(self)

impl Accelerometer[hw] for Icm42688
    fn accel_read(self) -> ?AccelMilliG [hw]
        accel_read_of(self)

    // The one data-ready flag, which clears when it is read.
    fn accel_ready(self) -> Bool [hw]
        data_ready_of(self)

    fn accel_range(self) -> AccelRange [hw]
        accel_range_read(self)

    fn accel_set_range(self, r: AccelRange) -> Bool [hw]
        accel_range_write(self, r)

    // The rate in whole hertz, to the nearest; 0 when the sensor is off.
    fn accel_rate_hz(self) -> Int [hw]
        accel_rate_hz_read(self)

    // 0 turns the sensor off.
    fn accel_set_rate_hz(self, hz: Int) -> Int [hw]
        accel_rate_hz_write(self, hz)

    // Packets in the FIFO, of both sensors when the gyroscope is batched.
    fn accel_fifo_count(self) -> Int [hw]
        fifo_count(self)

    fn accel_fifo_read(self, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
        fifo_read(self, var dst)

    // The rates in thousandths of a hertz, with the part's 1.5625, 3.125,
    // 6.25 and 12.5 Hz; 0 when the sensor is off, -1 when the part did not
    // answer.
    fn accel_rate_mhz(self) -> Int [hw]
        accel_rate_read(self)

    fn accel_set_rate_mhz(self, mhz: Int) -> Int [hw]
        accel_rate_write(self, mhz)

    fn accel_mode(self) -> ?AccelMode [hw]
        accel_mode_of(self)

    fn accel_set_mode(self, m: AccelMode) -> Bool [hw]
        accel_mode_set(self, m)

    fn accel_fifo_config(self, mode: AccelFifoMode, watermark: Int) -> Bool [hw]
        fifo_configure(self, mode, watermark)

    fn accel_fifo_watermark_reached(self) -> Bool [hw]
        fifo_watermark_reached(self)

impl Gyroscope[hw] for Icm42688
    fn gyro_read(self) -> ?GyroMilliDps [hw]
        gyro_read_of(self)

    // The one data-ready flag, which clears when it is read.
    fn gyro_ready(self) -> Bool [hw]
        data_ready_of(self)

    fn gyro_range(self) -> GyroRange [hw]
        gyro_range_read(self)

    fn gyro_set_range(self, r: GyroRange) -> Bool [hw]
        gyro_range_write(self, r)

    fn gyro_rate_hz(self) -> Int [hw]
        gyro_rate_hz_read(self)

impl Imu[hw] for Icm42688
    fn imu_read(self) -> ?ImuSample [hw]
        imu_read_of(self)

impl ImuControl[hw] for Icm42688
    // The one data-ready flag both sensors share, which clears when it is
    // read.
    fn imu_ready(self) -> Bool [hw]
        data_ready_of(self)

    fn imu_set_rate_hz(self, hz: Int) -> Int [hw]
        imu_rate_write(self, hz)

    fn imu_rate_hz(self) -> Int [hw]
        imu_rate_read(self)

    fn imu_standby(self, accel: Bool, gyro: Bool) -> Bool [hw]
        imu_standby_write(self, accel, gyro)

impl Thermometer[hw] for Icm42688
    // The sensor converts by itself while a motion sensor is on, so
    // nothing is started and no time is needed.
    fn temp_start(self) -> Int [hw]
        0

    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_of(self)

impl Identifiable[hw] for Icm42688
    // WHO_AM_I, 0x47; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

// ── The part on an SPI bus ───────────────────────────────────────────

// An ICM-42688-P on a board's SPI bus with the chip select `w.cs`, with the
// board's GPIO for the chip select and the INT1 line.
pub @value
struct Icm42688Spi
    bus: BoardSpi
    pins: BoardGpio
    w: DeviceWiring

impl Icm42688Port for Icm42688Spi
    fn setup(self) -> Bool [hw]
        spi_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        spi_read_into(self.bus, self.pins, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        spi_write(self.bus, self.pins, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

    fn on_spi(self) -> Bool [hw]
        true

    fn wait_us(self, us: Int) [hw]
        self.bus.delay_us(us)

impl Icm42688Spi
    // The part on the board's SPI bus with the chip select `w.cs`, as a
    // board's device table builds it.  Nothing is sent.
    fn attach(bus: BoardSpi, pins: BoardGpio, w: DeviceWiring) -> Icm42688Spi
        Icm42688Spi { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the wiring has no chip select.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The register of another bank (`bank_read`, `bank_update`).
    fn bank_reg(self, bank: Int, r: Int) -> ?Int [hw]
        bank_read(self, bank, r)

    fn set_bank_reg(self, bank: Int, r: Int, mask: Int, v: Int) -> Bool [hw]
        bank_update(self, bank, r, mask, v)

    // The gyroscope's setter for the rate, and its rates in thousandths of
    // a hertz; the accelerometer's are `Accelerometer.accel_rate_mhz` and
    // `accel_set_rate_mhz`.
    fn gyro_set_rate_hz(self, hz: Int) -> Int [hw]
        gyro_rate_hz_write(self, hz)

    fn gyro_rate_mhz(self) -> Int [hw]
        gyro_rate_read(self)

    fn set_gyro_rate_mhz(self, mhz: Int) -> Int [hw]
        gyro_rate_write(self, mhz)

    // The gyroscope's power mode and the temperature sensor; the
    // accelerometer's modes are `Accelerometer.accel_mode` and
    // `accel_set_mode`, and `ImuControl.imu_standby` turns either sensor
    // off.
    fn gyro_mode(self) -> Icm42688Mode [hw]
        gyro_mode_read(self)

    fn set_gyro_mode(self, m: Icm42688Mode) -> Bool [hw]
        gyro_mode_write(self, m)

    fn set_temp_enabled(self, on: Bool) -> Bool [hw]
        temp_enable(self, on)

    // The filters.
    fn accel_aaf(self, delt: Int) -> Bool [hw]
        accel_aaf_write(self, delt)

    fn accel_aaf_off(self) -> Bool [hw]
        accel_aaf_disable(self)

    fn gyro_aaf(self, delt: Int) -> Bool [hw]
        gyro_aaf_write(self, delt)

    fn gyro_aaf_off(self) -> Bool [hw]
        gyro_aaf_disable(self)

    fn set_ui_filter_order(self, accel_order: Int, gyro_order: Int) -> Bool [hw]
        ui_filter_order_write(self, accel_order, gyro_order)

    fn set_ui_filter_bw(self, accel_bw: Int, gyro_bw: Int) -> Bool [hw]
        ui_filter_bw_write(self, accel_bw, gyro_bw)

    // The interrupt pins, and INT_STATUS.
    fn route_int1(self, mask: Int) -> Bool [hw]
        int1_route(self, mask)

    fn route_int2(self, mask: Int) -> Bool [hw]
        int2_route(self, mask)

    fn configure_pins(self, active_low: Bool, open_drain: Bool) -> Bool [hw]
        int_pins_config(self, active_low, open_drain)

    fn set_int_timing(self, fast: Bool) -> Bool [hw]
        int_timing(self, fast)

    fn status(self) -> ?Int [hw]
        int_status(self)

    // The FIFO: off, and both sensors' samples.  It is turned on with
    // `Accelerometer.accel_fifo_config`.
    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    fn fifo_take_imu(self, var accel: Vec[AccelMilliG; 32],
                     var gyro: Vec[GyroMilliDps; 32]) -> Int [hw]
        fifo_read_imu(self, var accel, var gyro)

    // The self-tests (`accel_self_test`, `gyro_self_test`).
    fn accel_test(self) -> ?AccelMilliG [hw]
        accel_self_test(self)

    fn gyro_test(self) -> ?GyroMilliDps [hw]
        gyro_self_test(self)

impl Accelerometer[hw] for Icm42688Spi
    fn accel_read(self) -> ?AccelMilliG [hw]
        accel_read_of(self)

    // The one data-ready flag, which clears when it is read.
    fn accel_ready(self) -> Bool [hw]
        data_ready_of(self)

    fn accel_range(self) -> AccelRange [hw]
        accel_range_read(self)

    fn accel_set_range(self, r: AccelRange) -> Bool [hw]
        accel_range_write(self, r)

    // The rate in whole hertz, to the nearest; 0 when the sensor is off.
    fn accel_rate_hz(self) -> Int [hw]
        accel_rate_hz_read(self)

    // 0 turns the sensor off.
    fn accel_set_rate_hz(self, hz: Int) -> Int [hw]
        accel_rate_hz_write(self, hz)

    // Packets in the FIFO, of both sensors when the gyroscope is batched.
    fn accel_fifo_count(self) -> Int [hw]
        fifo_count(self)

    fn accel_fifo_read(self, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
        fifo_read(self, var dst)

    // The rates in thousandths of a hertz, with the part's 1.5625, 3.125,
    // 6.25 and 12.5 Hz; 0 when the sensor is off, -1 when the part did not
    // answer.
    fn accel_rate_mhz(self) -> Int [hw]
        accel_rate_read(self)

    fn accel_set_rate_mhz(self, mhz: Int) -> Int [hw]
        accel_rate_write(self, mhz)

    fn accel_mode(self) -> ?AccelMode [hw]
        accel_mode_of(self)

    fn accel_set_mode(self, m: AccelMode) -> Bool [hw]
        accel_mode_set(self, m)

    fn accel_fifo_config(self, mode: AccelFifoMode, watermark: Int) -> Bool [hw]
        fifo_configure(self, mode, watermark)

    fn accel_fifo_watermark_reached(self) -> Bool [hw]
        fifo_watermark_reached(self)

impl Gyroscope[hw] for Icm42688Spi
    fn gyro_read(self) -> ?GyroMilliDps [hw]
        gyro_read_of(self)

    // The one data-ready flag, which clears when it is read.
    fn gyro_ready(self) -> Bool [hw]
        data_ready_of(self)

    fn gyro_range(self) -> GyroRange [hw]
        gyro_range_read(self)

    fn gyro_set_range(self, r: GyroRange) -> Bool [hw]
        gyro_range_write(self, r)

    fn gyro_rate_hz(self) -> Int [hw]
        gyro_rate_hz_read(self)

impl Imu[hw] for Icm42688Spi
    fn imu_read(self) -> ?ImuSample [hw]
        imu_read_of(self)

impl ImuControl[hw] for Icm42688Spi
    // The one data-ready flag both sensors share, which clears when it is
    // read.
    fn imu_ready(self) -> Bool [hw]
        data_ready_of(self)

    fn imu_set_rate_hz(self, hz: Int) -> Int [hw]
        imu_rate_write(self, hz)

    fn imu_rate_hz(self) -> Int [hw]
        imu_rate_read(self)

    fn imu_standby(self, accel: Bool, gyro: Bool) -> Bool [hw]
        imu_standby_write(self, accel, gyro)

impl Thermometer[hw] for Icm42688Spi
    // The sensor converts by itself while a motion sensor is on, so
    // nothing is started and no time is needed.
    fn temp_start(self) -> Int [hw]
        0

    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_of(self)

impl Identifiable[hw] for Icm42688Spi
    // WHO_AM_I, 0x47; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)
